# ============================================================
# BACKEND ENVIRONMENT VARIABLES (apps/backend/.env)
# ============================================================

# PostgreSQL Database Connection (keep existing format)
DB_USER=your_db_user
DB_HOST=localhost
DB_NAME=the_project
DB_PASSWORD=your_db_password
DB_PORT=5432

# Authentication
JWT_SECRET=replace-this-with-a-random-32-char-string-minimum

# Server
PORT=4000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Optional: Git Integration
GIT_GITHUB_TOKEN=
GIT_GITLAB_TOKEN=
GIT_BITBUCKET_TOKEN=

# ============================================================
# FRONTEND ENVIRONMENT VARIABLES (apps/web/.env.local)
# ============================================================

NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: Analytics, Sentry, etc.
# NEXT_PUBLIC_SENTRY_DSN=
